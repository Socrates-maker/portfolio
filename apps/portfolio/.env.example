# Neon connection string (pooled), from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require"

# Password checked by the /admin/login form. Pick a strong one.
ADMIN_PASSWORD=""

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Vercel Blob store token, used by the admin to upload project screenshots.
# Create a Blob store in the Vercel dashboard (Storage tab) and copy its
# read/write token — Vercel injects this automatically when the store is
# linked to the project, so it's usually only needed for local dev.
BLOB_READ_WRITE_TOKEN=""
